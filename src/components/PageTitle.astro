---
/**
 * Page title: Starlight's own title, plus the page actions (copy, view as Markdown, print,
 * open in ChatGPT / Claude / Perplexity: src/components/PageActions.astro) on its right on
 * the guide pages (src/content/docs/{fr,en}/guides/).
 *
 * Set in astro.config.mjs (`components: { PageTitle: ... }`).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageActions from './PageActions.astro';

const { id } = Astro.locals.starlightRoute;
const isGuide = /^(fr|en)\/guides\//.test(id);
---

{
	isGuide ? (
		<div class="guide-title-row">
			<Default />
			<PageActions />
		</div>
	) : (
		<Default />
	)
}
