---
/**
 * Page title: Starlight's own title, plus a "Print" button on its right on the guide pages
 * (src/content/docs/{fr,en}/guides/). The click is handled by public/print.js.
 *
 * Set in astro.config.mjs (`components: { PageTitle: ... }`).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { id, locale } = Astro.locals.starlightRoute;
const isGuide = /^(fr|en)\/guides\//.test(id);
const label = locale === 'en' ? 'Print' : 'Imprimer';
---

{
	isGuide ? (
		<div class="guide-title-row">
			<Default />
			<button type="button" class="guide-print" data-print-guide>
				{label}
			</button>
		</div>
	) : (
		<Default />
	)
}
