---
/**
 * Homepage card with a picture: Starlight's LinkCard look, plus a picture on top.
 *
 * Used in src/content/docs/{fr,en}/index.mdx, inside Starlight's CardGrid. The whole card is
 * clickable. Without `image`, the top shows a Starlight icon (`icon`) instead, e.g. for a
 * machine that has no photo yet. `external` opens the link in a new tab. `background` and
 * `iconColor` (CSS colors) change the top area's color and the icon's color, e.g. for the shop.
 * `level` ('beginner' or 'advanced') shows a level badge after the description, in the style
 * of Flowbite's pill badges (green "Débutant" / orange "Avancé", in the page's language).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
	title: string;
	description: string;
	href: string;
	image?: ImageMetadata;
	alt?: string;
	icon?: StarlightIcon;
	external?: boolean;
	background?: string;
	iconColor?: string;
	level?: 'beginner' | 'advanced';
}

const {
	title,
	description,
	href,
	image,
	alt = '',
	icon = 'puzzle',
	external = false,
	background,
	iconColor,
	level,
} = Astro.props;
const target = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const pictureStyle = background || iconColor ? { background, color: iconColor } : undefined;
const en = Astro.locals.starlightRoute.locale === 'en';
const LEVELS = { beginner: en ? 'Beginner' : 'Débutant', advanced: en ? 'Advanced' : 'Avancé' };
---

<div class="machine-card not-content">
	<!-- data-zoom="off": the whole card is a link, so its picture does not open the picture viewer -->
	<div class="picture" style={pictureStyle} data-zoom="off">
		{
			image ? (
				<Image src={image} alt={alt} widths={[400, 800]} sizes="(min-width: 50rem) 22rem, 100vw" />
			) : (
				<Icon name={icon} size="3.5rem" />
			)
		}
	</div>
	<div class="text">
		<a href={href} {...target}>
			<span class="title" set:html={title} />
		</a>
		<span class="description" set:html={description} />
		{level && <span class={`level level-${level}`} data-level={level}>{LEVELS[level]}</span>}
	</div>
	<Icon name={external ? 'external' : 'right-arrow'} size="1.333em" class="arrow rtl:flip" />
</div>

<style>
	.machine-card {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto 1fr;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-sm);
		overflow: hidden;
	}
	.picture {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 11rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-text-accent);
	}
	/* Level badge after the description: Flowbite's pill badge (Tailwind classes
	   text-xs font-medium px-2.5 py-0.5 rounded-full, -100 background / -800 text; dark mode
	   -900 background / -300 text), written with Tailwind's colour values */
	.level {
		align-self: flex-start;
		padding: 0.125rem 0.625rem;
		border-radius: 9999px;
		font-family: var(--sl-font-system);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1rem;
		background: var(--level-bg);
		color: var(--level-text);
	}
	.level-beginner {
		--level-bg: #dcfce7;
		--level-text: #166534;
	}
	.level-advanced {
		--level-bg: #ffedd5;
		--level-text: #9a3412;
	}
	:global([data-theme='dark']) .level-beginner {
		--level-bg: #14532d;
		--level-text: #86efac;
	}
	:global([data-theme='dark']) .level-advanced {
		--level-bg: #7c2d12;
		--level-text: #fdba74;
	}
	.picture img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	a {
		text-decoration: none;
		line-height: var(--sl-line-height-headings);
	}
	/* The whole card is the link */
	a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-lg);
	}
	.description {
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.arrow {
		align-self: center;
		margin-inline-end: 1rem;
		color: var(--sl-color-gray-3);
	}
	.machine-card:hover {
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-color: var(--sl-color-gray-2);
	}
	.machine-card:hover .arrow {
		color: var(--sl-color-white);
	}
</style>
