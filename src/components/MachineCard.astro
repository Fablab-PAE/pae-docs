---
/**
 * Homepage card with a picture: Starlight's LinkCard look, plus a picture on top.
 *
 * Used in src/content/docs/{fr,en}/index.mdx, inside Starlight's CardGrid. The whole card is
 * clickable. Without `image`, the top shows a Starlight icon (`icon`) instead, e.g. for a
 * machine that has no photo yet. `external` opens the link in a new tab. `background` and
 * `iconColor` (CSS colors) change the top area's color and the icon's color, e.g. for the shop.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
	title: string;
	description: string;
	href: string;
	image?: ImageMetadata;
	alt?: string;
	icon?: StarlightIcon;
	external?: boolean;
	background?: string;
	iconColor?: string;
}

const { title, description, href, image, alt = '', icon = 'puzzle', external = false, background, iconColor } =
	Astro.props;
const target = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const pictureStyle = { background, color: iconColor };
---

<div class="machine-card not-content">
	<div class="picture" style={pictureStyle}>
		{
			image ? (
				<Image src={image} alt={alt} widths={[400, 800]} sizes="(min-width: 50rem) 22rem, 100vw" />
			) : (
				<Icon name={icon} size="3.5rem" />
			)
		}
	</div>
	<div class="text">
		<a href={href} {...target}>
			<span class="title" set:html={title} />
		</a>
		<span class="description" set:html={description} />
	</div>
	<Icon name={external ? 'external' : 'right-arrow'} size="1.333em" class="arrow rtl:flip" />
</div>

<style>
	.machine-card {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto 1fr;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: var(--sl-shadow-sm);
		overflow: hidden;
	}
	.picture {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 11rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-text-accent);
	}
	.picture img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.text {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem;
	}
	a {
		text-decoration: none;
		line-height: var(--sl-line-height-headings);
	}
	/* The whole card is the link */
	a::before {
		content: '';
		position: absolute;
		inset: 0;
	}
	.title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-lg);
	}
	.description {
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}
	.arrow {
		align-self: center;
		margin-inline-end: 1rem;
		color: var(--sl-color-gray-3);
	}
	.machine-card:hover {
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-color: var(--sl-color-gray-2);
	}
	.machine-card:hover .arrow {
		color: var(--sl-color-white);
	}
</style>
