---
/**
 * Page footer: Starlight's own footer, plus the viewer that opens the guide images full
 * screen when they are clicked (starlight-image-zoom).
 *
 * Set in astro.config.mjs (`components: { Footer: ... }`). The plugin usually adds its viewer
 * through MarkdownContent, but that component is the agent kit's (the "Enlarge" button on
 * diagrams), so the viewer is placed here instead. It is one element per page and finds the
 * images by itself.
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import ImageZoom from 'starlight-image-zoom/components/ImageZoom.astro';
---

<Default />
<ImageZoom />
